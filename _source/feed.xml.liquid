---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ env.language }}">
  <generator uri="https://www.11ty.dev/">Eleventy</generator>
  <link href="{{ env.baseUrl }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ env.baseUrl }}/" rel="alternate" type="text/html" hreflang="{{ env.language }}" />
  <title type="html">{{ site.title | escape }}</title>
  <subtitle>{{ site.description | escape }}</subtitle>
  <updated>{{ collections.posts[0].date | date: "%Y-%m-%dT%H:%M:%S", "UTC" }}Z</updated>
  <author>
    <name>{{ env.author | escape }}</name>
  </author>
  <id>{{ env.baseUrl }}/feed.xml</id>
    {% assign latest = collections.posts | sort: "date" | reverse %}
  {% for post in latest %}
  <entry>
    <title type="html">{{ post.data.title | escape }}</title>
    <link href="{{ env.baseUrl }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.data.title | escape }}" />
    <published>{{ post.date | date: "%Y-%m-%dT%H:%M:%S", "UTC" }}Z</published>
    <updated>{{ post.date | date: "%Y-%m-%dT%H:%M:%S", "UTC" }}Z</updated>
    <id>{{ env.baseUrl }}{{ post.url }}</id>
    <content type="html" xml:base="{{ env.baseUrl }}{{ post.url }}">
      <![CDATA[{{ post.templateContent }}]]>
    </content>
    <author>
      <name>{{ env.author | escape }}</name>
    </author>
    {% for category in post.data.categories %}
    <category term="{{ category | escape }}" />
    {% endfor %}
    {% for tag in post.data.tags %}
    <category term="{{ tag | escape }}" />
    {% endfor %}
    <summary type="html"><![CDATA[{{ post.templateContent | split: "<!--more-->" | first }}]]></summary>
  </entry>
  {% endfor %}
</feed>
